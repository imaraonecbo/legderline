# Required for production checkout; use Stripe TEST keys first, then live keys after tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://your-service.onrender.com
# Set a long random token; send it as Authorization: Bearer <token> to /admin/summary
LEDGERLINE_ADMIN_TOKEN=
# Render persistent disk mount example: /var/data/ledgerline.db
LEDGERLINE_DB_PATH=./ledgerline/ledgerline.db
